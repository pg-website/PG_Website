DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
# Direct connection (local dev, or Railway with Outbound IPv6 enabled):
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
# Supabase connection pooler — use this on Railway (IPv4, no IPv6 needed):
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_USER=postgres.xxxxxxxxxxxx   (note: project-ref is part of the username for the pooler)
# DB_SSLMODE=require
# Auth: body (tokens in JSON) or cookie (httpOnly refresh cookie). Number of trusted reverse proxies for client IP (0 = none).
AUTH_TOKEN_MODE=body
TRUSTED_PROXY_COUNT=0
# Razorpay. RAZORPAY_MODE: fake (local dev, DEBUG only, no network) or live. Default: fake when DEBUG, live otherwise.
# In live mode all three secrets are required at startup. The values below are placeholders, not real keys.
RAZORPAY_MODE=fake
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=placeholder-key-secret
RAZORPAY_WEBHOOK_SECRET=placeholder-webhook-secret
RAZORPAY_API_BASE=https://api.razorpay.com/v1
SENDGRID_API_KEY=SG.xxxx
# Email adapter: django (default; SendGrid via anymail, console backend when DEBUG) | fake (DEBUG only) | dotted.path.Class
EMAIL_ADAPTER=django
# Use EMAIL_ADAPTER=fake (DEBUG only) when running scheduler/worker jobs locally so no real email is sent.
# Optional tunables read by the scheduler (defaults shown): minutes check-in opens before start / stays open after it.
# CHECKIN_OPENS_MINUTES_BEFORE=30
# CHECKIN_CLOSES_MINUTES_AFTER=15
# Where contact-form submissions are emailed when no admin setting is saved (empty = the public support email)
CONTACT_DESTINATION_EMAIL=
FRONTEND_URL=https://pgchess.in
CORS_ALLOWED_ORIGINS=https://pgchess.in,https://www.pgchess.in,http://localhost:5173
# Supabase Storage (backend only; never expose the secret key to the web app)
# STORAGE_MODE: fake (local disk under backend/.fake_storage, DEBUG only, no network) or supabase.
# Default: fake when DEBUG, supabase otherwise. supabase needs SUPABASE_URL and SUPABASE_SECRET_KEY at startup.
STORAGE_MODE=fake
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_MEDIA_BUCKET=pg-media
# Preferred for production with sb_secret_ keys: Supabase Storage > S3 > New access key (backend-only).
# When both are set, storage uses the S3 protocol and SUPABASE_SECRET_KEY is not needed for storage.
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION=ap-southeast-1
# Draft preview: shared secret the web server sends as a bearer to POST /api/preview/exchange. Placeholder only; unset disables preview.
PREVIEW_SECRET=placeholder-preview-secret
